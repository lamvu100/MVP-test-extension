{
  "manifest_version": 3,
  "name": "enoVestor Bug Capture",
  "version": "0.1.0",
  "description": "Records what you do in an enoVestor tab while you reproduce a bug, and saves it as a report file. Sends nothing anywhere.",
  "minimum_chrome_version": "112",

  "permissions": ["storage", "alarms", "tabs", "activeTab"],
  "host_permissions": ["https://irs.enovestor.com/*", "http://localhost/*"],

  "background": { "service_worker": "service-worker.js" },

  "action": {
    "default_popup": "popup.html",
    "default_title": "enoVestor Bug Capture",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
